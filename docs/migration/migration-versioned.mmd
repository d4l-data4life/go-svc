flowchart TB
  A["Reserve connection and acquire cancellable advisory lock"] --> B["Read and validate migration state"]
  B -->|"Already at target, clean"| Z["Release connection and lock"]
  B -->|"Unsupported or dirty"| E["Fail startup; explicit recovery for dirty state"]
  B -->|"Work pending"| C["Record next version dirty"]
  C --> D["setup.sql then fdw.up.sql, if present"]
  D --> F{"Fresh latest bootstrap?"}
  F -->|Yes| G["AutoMigrate(target), without version hooks"]
  F -->|No| H["before(N), AutoMigrate(N), after(N)"]
  H --> I{"More versions?"}
  I -->|Yes| J["Record N clean, then N+1 dirty"]
  J --> H
  I -->|No| K["fdw.down.sql, if present"]
  G --> K
  K --> L["Record target clean"]
  L --> Z
  E --> Z
  C -. "Any later error leaves dirty; cleanup cannot turn failure into success" .-> E
